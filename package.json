{
  "name": "@hyunicode/create-web-template",
  "version": "1.0.1",
  "description": "Create an Rsbuild + React + TypeScript app from this template",
  "type": "module",
  "bin": {
    "create-web-template": "./src/index.ts"
  },
  "files": [
    "src",
    "template"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun run --cwd template build",
    "check": "prettier --check .",
    "create": "bun src/index.ts",
    "dev": "bun run --cwd template dev",
    "format": "prettier --write .",
    "lint": "eslint . && stylelint \"template/**/*.css\"",
    "preview": "bun run --cwd template preview",
    "prepare": "bunx husky",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p template"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyunicode/web-template.git"
  },
  "keywords": [
    "bun",
    "create",
    "react",
    "rsbuild",
    "template",
    "typescript"
  ],
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
